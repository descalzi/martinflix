{
  "groups": [
    {"name": "Core", "services": ["tailscale", "portainer"]},
    {"name": "Media server", "services": ["plex"]},
    {"name": "Downloads & automation", "services": ["nordvpn", "transmission-daemon", "flaresolverr", "prowlarr", "bazarr", "sonarr", "radarr"]},
    {"name": "Books", "services": ["bookorbit-db", "bookorbit-app"]},
    {"name": "Web services", "services": ["homepage", "seerr", "tautulli"]},
    {"name": "Bookshelf", "services": ["bookshelf"]}
  ],
  "apps": {
    "tailscale": {"name": "Tailscale", "role": "Private network", "icon": "tailscale", "note": "No web page here. Manage it in the Tailscale admin console."},
    "portainer": {"name": "Portainer", "role": "Container management", "icon": "portainer", "web": {"port": 9443, "scheme": "https"}},
    "plex": {"name": "Plex", "role": "Media streaming", "icon": "plex", "web": {"port": 32400, "path": "/web/"}},
    "nordvpn": {"name": "Gluetun", "role": "NordVPN gateway", "icon": "gluetun", "note": "No web page. It only carries the download apps’ traffic."},
    "dashboard": {"name": "Dashboard", "role": "This page", "icon": "martinflix-mark"},
    "controller": {"name": "Controller", "role": "Restarts and updates apps", "icon": "martinflix-mark", "note": "No web page. Only the dashboard can reach it."},
    "transmission-auth": {"name": "Transmission login", "role": "Keeps Transmission’s password in step", "icon": "transmission", "note": "No web page. It applies your dashboard password to Transmission."},
    "transmission-daemon": {"name": "Transmission", "role": "Downloads", "icon": "transmission", "web": {"port": 9091}, "installer": {"env": "TRANSMISSION", "localOnly": true}},
    "flaresolverr": {"name": "FlareSolverr", "role": "Indexer support", "icon": "flaresolverr", "note": "No web page. Prowlarr calls it in the background."},
    "prowlarr": {"name": "Prowlarr", "role": "Indexer management", "icon": "prowlarr", "web": {"port": 9696}, "installer": {"env": "PROWLARR", "localOnly": true}},
    "bazarr": {"name": "Bazarr", "role": "Subtitles", "icon": "bazarr", "web": {"port": 6767}, "installer": {"env": "BAZARR", "localOnly": true}},
    "sonarr": {"name": "Sonarr", "role": "TV library", "icon": "sonarr", "web": {"port": 8989}, "installer": {"env": "SONARR"}},
    "radarr": {"name": "Radarr", "role": "Film library", "icon": "radarr", "web": {"port": 7878}, "installer": {"env": "RADARR"}},
    "bookorbit-db": {"name": "PostgreSQL", "role": "BookOrbit database", "icon": "postgresql", "note": "No web page. BookOrbit stores its library here."},
    "bookorbit-app": {"name": "BookOrbit", "role": "Book library", "icon": "bookorbit", "web": {"port": 3001}},
    "homepage": {"name": "Homepage", "role": "App launcher", "icon": "homepage", "web": {"port": 3000}},
    "seerr": {"name": "Seerr", "role": "Media requests", "icon": "seerr", "web": {"port": 5055}},
    "tautulli": {"name": "Tautulli", "role": "Plex activity", "icon": "tautulli", "web": {"port": 8181}},
    "bookshelf": {"name": "Bookshelf", "role": "Optional book automation", "icon": "bookshelf", "web": {"port": 8787}, "optional": true}
  },
  "branches": {
    "nordvpn": {"title": "VPN network", "description": "Gluetun sends these apps’ traffic through NordVPN.", "members": ["transmission-daemon", "flaresolverr", "prowlarr", "bazarr"]},
    "bookorbit-db": {"title": "BookOrbit database", "description": "BookOrbit starts after PostgreSQL is healthy.", "members": ["bookorbit-app"]}
  },
  "startAfter": {
    "sonarr": ["prowlarr", "transmission-daemon"],
    "radarr": ["prowlarr", "transmission-daemon"]
  },
  "uses": {
    "sonarr": ["prowlarr", "transmission-daemon"],
    "radarr": ["prowlarr", "transmission-daemon"],
    "prowlarr": ["flaresolverr"],
    "bazarr": ["sonarr", "radarr"]
  },
  "groupRest": {
    "Downloads & automation": {"title": "Library", "description": "Sonarr and Radarr find, download and organise your series and films."}
  }
}
