[Unit]
Description=MartinFlix control room
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=martin
WorkingDirectory=/mnt/martinflix/Data/git/martinflix
EnvironmentFile=/etc/martinflix/dashboard.env
ExecStart=/usr/bin/python3 /mnt/martinflix/Data/git/martinflix/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
